{
    "openapi": "3.1.2",
    "info": {
        "title": "Laravel",
        "version": "0.0.1"
    },
    "servers": [
        {
            "url": "http://localhost:8000/api"
        }
    ],
    "security": [
        {
            "http": []
        }
    ],
    "paths": {
        "/me": {
            "get": {
                "operationId": "auth.me",
                "summary": "Show the workshop that owns the bearer token",
                "tags": [
                    "Auth"
                ],
                "responses": {
                    "200": {
                        "description": "`WorkshopResource`",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "type": "object",
                                    "properties": {
                                        "data": {
                                            "$ref": "#/components/schemas/WorkshopResource"
                                        }
                                    },
                                    "required": [
                                        "data"
                                    ]
                                }
                            }
                        }
                    },
                    "401": {
                        "$ref": "#/components/responses/AuthenticationException"
                    }
                }
            }
        },
        "/brands": {
            "get": {
                "operationId": "brand.index",
                "summary": "List the brands with how many parts match the active search and condition",
                "tags": [
                    "Brand"
                ],
                "parameters": [
                    {
                        "name": "q",
                        "in": "query",
                        "schema": {
                            "type": [
                                "string",
                                "null"
                            ],
                            "maxLength": 100
                        }
                    },
                    {
                        "name": "condition",
                        "in": "query",
                        "schema": {
                            "anyOf": [
                                {
                                    "$ref": "#/components/schemas/Condition"
                                },
                                {
                                    "type": "null"
                                }
                            ]
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Array of `BrandResource`",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "type": "object",
                                    "properties": {
                                        "data": {
                                            "type": "array",
                                            "items": {
                                                "$ref": "#/components/schemas/BrandResource"
                                            }
                                        }
                                    },
                                    "required": [
                                        "data"
                                    ]
                                }
                            }
                        }
                    },
                    "401": {
                        "$ref": "#/components/responses/AuthenticationException"
                    },
                    "422": {
                        "$ref": "#/components/responses/ValidationException"
                    }
                }
            }
        },
        "/parts": {
            "get": {
                "operationId": "part.index",
                "summary": "List the parts that match the search, brand and condition filters, sorted and paginated",
                "tags": [
                    "Part"
                ],
                "parameters": [
                    {
                        "name": "q",
                        "in": "query",
                        "schema": {
                            "type": [
                                "string",
                                "null"
                            ],
                            "maxLength": 100
                        }
                    },
                    {
                        "name": "brand[]",
                        "in": "query",
                        "schema": {
                            "type": "array",
                            "items": {
                                "type": "string",
                                "maxLength": 100
                            }
                        }
                    },
                    {
                        "name": "condition",
                        "in": "query",
                        "schema": {
                            "anyOf": [
                                {
                                    "$ref": "#/components/schemas/Condition"
                                },
                                {
                                    "type": "null"
                                }
                            ]
                        }
                    },
                    {
                        "name": "sort",
                        "in": "query",
                        "schema": {
                            "type": [
                                "string",
                                "null"
                            ],
                            "enum": [
                                "price_asc",
                                "price_desc",
                                null
                            ]
                        }
                    },
                    {
                        "name": "page",
                        "in": "query",
                        "schema": {
                            "type": "integer",
                            "minimum": 1
                        }
                    },
                    {
                        "name": "per_page",
                        "in": "query",
                        "schema": {
                            "type": "integer",
                            "minimum": 1,
                            "maximum": 50
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Paginated set of `PartResource`",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "type": "object",
                                    "properties": {
                                        "data": {
                                            "type": "array",
                                            "items": {
                                                "$ref": "#/components/schemas/PartResource"
                                            }
                                        },
                                        "links": {
                                            "type": "object",
                                            "properties": {
                                                "first": {
                                                    "type": [
                                                        "string",
                                                        "null"
                                                    ]
                                                },
                                                "last": {
                                                    "type": [
                                                        "string",
                                                        "null"
                                                    ]
                                                },
                                                "prev": {
                                                    "type": [
                                                        "string",
                                                        "null"
                                                    ]
                                                },
                                                "next": {
                                                    "type": [
                                                        "string",
                                                        "null"
                                                    ]
                                                }
                                            },
                                            "required": [
                                                "first",
                                                "last",
                                                "prev",
                                                "next"
                                            ]
                                        },
                                        "meta": {
                                            "type": "object",
                                            "properties": {
                                                "current_page": {
                                                    "type": "integer",
                                                    "minimum": 1
                                                },
                                                "from": {
                                                    "type": [
                                                        "integer",
                                                        "null"
                                                    ],
                                                    "minimum": 1
                                                },
                                                "last_page": {
                                                    "type": "integer",
                                                    "minimum": 1
                                                },
                                                "links": {
                                                    "type": "array",
                                                    "description": "Generated paginator links.",
                                                    "items": {
                                                        "type": "object",
                                                        "properties": {
                                                            "url": {
                                                                "type": [
                                                                    "string",
                                                                    "null"
                                                                ]
                                                            },
                                                            "label": {
                                                                "type": "string"
                                                            },
                                                            "active": {
                                                                "type": "boolean"
                                                            }
                                                        },
                                                        "required": [
                                                            "url",
                                                            "label",
                                                            "active"
                                                        ]
                                                    }
                                                },
                                                "path": {
                                                    "type": [
                                                        "string",
                                                        "null"
                                                    ],
                                                    "description": "Base path for paginator generated URLs."
                                                },
                                                "per_page": {
                                                    "type": "integer",
                                                    "description": "Number of items shown per page.",
                                                    "minimum": 0
                                                },
                                                "to": {
                                                    "type": [
                                                        "integer",
                                                        "null"
                                                    ],
                                                    "description": "Number of the last item in the slice.",
                                                    "minimum": 1
                                                },
                                                "total": {
                                                    "type": "integer",
                                                    "description": "Total number of items being paginated.",
                                                    "minimum": 0
                                                }
                                            },
                                            "required": [
                                                "current_page",
                                                "from",
                                                "last_page",
                                                "links",
                                                "path",
                                                "per_page",
                                                "to",
                                                "total"
                                            ]
                                        }
                                    },
                                    "required": [
                                        "data",
                                        "links",
                                        "meta"
                                    ]
                                }
                            }
                        }
                    },
                    "401": {
                        "$ref": "#/components/responses/AuthenticationException"
                    },
                    "422": {
                        "$ref": "#/components/responses/ValidationException"
                    }
                }
            }
        },
        "/parts/{part}": {
            "get": {
                "operationId": "part.show",
                "summary": "Show one part",
                "tags": [
                    "Part"
                ],
                "parameters": [
                    {
                        "name": "part",
                        "in": "path",
                        "required": true,
                        "description": "The part.",
                        "schema": {
                            "type": "integer"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "`PartResource`",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "type": "object",
                                    "properties": {
                                        "data": {
                                            "$ref": "#/components/schemas/PartResource"
                                        }
                                    },
                                    "required": [
                                        "data"
                                    ]
                                }
                            }
                        }
                    },
                    "404": {
                        "$ref": "#/components/responses/ModelNotFoundException"
                    },
                    "401": {
                        "$ref": "#/components/responses/AuthenticationException"
                    }
                }
            }
        },
        "/quotes": {
            "post": {
                "operationId": "quote.store",
                "summary": "Start a new draft quote for the authenticated workshop",
                "tags": [
                    "Quote"
                ],
                "responses": {
                    "201": {
                        "description": "`QuoteResource`",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "type": "object",
                                    "properties": {
                                        "data": {
                                            "$ref": "#/components/schemas/QuoteResource"
                                        }
                                    },
                                    "required": [
                                        "data"
                                    ]
                                }
                            }
                        }
                    },
                    "401": {
                        "$ref": "#/components/responses/AuthenticationException"
                    }
                }
            }
        },
        "/quotes/{quote}": {
            "get": {
                "operationId": "quote.show",
                "summary": "Show one of the workshop's quotes",
                "tags": [
                    "Quote"
                ],
                "parameters": [
                    {
                        "name": "quote",
                        "in": "path",
                        "required": true,
                        "description": "The quote, resolved only among the workshop's own quotes.",
                        "schema": {
                            "type": "integer"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "`QuoteResource`",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "type": "object",
                                    "properties": {
                                        "data": {
                                            "$ref": "#/components/schemas/QuoteResource"
                                        }
                                    },
                                    "required": [
                                        "data"
                                    ]
                                }
                            }
                        }
                    },
                    "404": {
                        "$ref": "#/components/responses/ModelNotFoundException"
                    },
                    "403": {
                        "$ref": "#/components/responses/AuthorizationException"
                    },
                    "401": {
                        "$ref": "#/components/responses/AuthenticationException"
                    }
                }
            }
        },
        "/quotes/{quote}/submit": {
            "post": {
                "operationId": "quote.submit",
                "summary": "Submit a draft quote",
                "tags": [
                    "Quote"
                ],
                "parameters": [
                    {
                        "name": "quote",
                        "in": "path",
                        "required": true,
                        "description": "The draft quote.",
                        "schema": {
                            "type": "integer"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "`QuoteResource`",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "type": "object",
                                    "properties": {
                                        "data": {
                                            "$ref": "#/components/schemas/QuoteResource"
                                        }
                                    },
                                    "required": [
                                        "data"
                                    ]
                                }
                            }
                        }
                    },
                    "422": {
                        "$ref": "#/components/responses/ValidationException"
                    },
                    "404": {
                        "$ref": "#/components/responses/ModelNotFoundException"
                    },
                    "403": {
                        "$ref": "#/components/responses/AuthorizationException"
                    },
                    "401": {
                        "$ref": "#/components/responses/AuthenticationException"
                    }
                }
            }
        },
        "/quotes/{quote}/lines": {
            "post": {
                "operationId": "quoteLine.store",
                "summary": "Add a part to the quote",
                "tags": [
                    "QuoteLine"
                ],
                "parameters": [
                    {
                        "name": "quote",
                        "in": "path",
                        "required": true,
                        "description": "The draft quote.",
                        "schema": {
                            "type": "integer"
                        }
                    }
                ],
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "$ref": "#/components/schemas/AddQuoteLineRequest"
                            }
                        }
                    }
                },
                "responses": {
                    "201": {
                        "description": "`QuoteResource`",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "type": "object",
                                    "properties": {
                                        "data": {
                                            "$ref": "#/components/schemas/QuoteResource"
                                        }
                                    },
                                    "required": [
                                        "data"
                                    ]
                                }
                            }
                        }
                    },
                    "404": {
                        "$ref": "#/components/responses/ModelNotFoundException"
                    },
                    "422": {
                        "$ref": "#/components/responses/ValidationException"
                    },
                    "403": {
                        "$ref": "#/components/responses/AuthorizationException"
                    },
                    "401": {
                        "$ref": "#/components/responses/AuthenticationException"
                    }
                }
            }
        },
        "/quotes/{quote}/lines/{line}": {
            "patch": {
                "operationId": "quoteLine.update",
                "summary": "Change the quantity or colour of a line",
                "tags": [
                    "QuoteLine"
                ],
                "parameters": [
                    {
                        "name": "quote",
                        "in": "path",
                        "required": true,
                        "description": "The draft quote.",
                        "schema": {
                            "type": "integer"
                        }
                    },
                    {
                        "name": "line",
                        "in": "path",
                        "required": true,
                        "description": "The line, resolved only among this quote's lines.",
                        "schema": {
                            "type": "integer"
                        }
                    }
                ],
                "requestBody": {
                    "content": {
                        "application/json": {
                            "schema": {
                                "$ref": "#/components/schemas/UpdateQuoteLineRequest"
                            }
                        }
                    }
                },
                "responses": {
                    "200": {
                        "description": "`QuoteResource`",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "type": "object",
                                    "properties": {
                                        "data": {
                                            "$ref": "#/components/schemas/QuoteResource"
                                        }
                                    },
                                    "required": [
                                        "data"
                                    ]
                                }
                            }
                        }
                    },
                    "422": {
                        "$ref": "#/components/responses/ValidationException"
                    },
                    "404": {
                        "$ref": "#/components/responses/ModelNotFoundException"
                    },
                    "403": {
                        "$ref": "#/components/responses/AuthorizationException"
                    },
                    "401": {
                        "$ref": "#/components/responses/AuthenticationException"
                    }
                }
            },
            "delete": {
                "operationId": "quoteLine.destroy",
                "summary": "Remove a line from the quote",
                "tags": [
                    "QuoteLine"
                ],
                "parameters": [
                    {
                        "name": "quote",
                        "in": "path",
                        "required": true,
                        "description": "The draft quote.",
                        "schema": {
                            "type": "integer"
                        }
                    },
                    {
                        "name": "line",
                        "in": "path",
                        "required": true,
                        "description": "The line, resolved only among this quote's lines.",
                        "schema": {
                            "type": "integer"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "`QuoteResource`",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "type": "object",
                                    "properties": {
                                        "data": {
                                            "$ref": "#/components/schemas/QuoteResource"
                                        }
                                    },
                                    "required": [
                                        "data"
                                    ]
                                }
                            }
                        }
                    },
                    "404": {
                        "$ref": "#/components/responses/ModelNotFoundException"
                    },
                    "403": {
                        "$ref": "#/components/responses/AuthorizationException"
                    },
                    "401": {
                        "$ref": "#/components/responses/AuthenticationException"
                    }
                }
            }
        }
    },
    "components": {
        "securitySchemes": {
            "http": {
                "type": "http",
                "scheme": "bearer"
            }
        },
        "schemas": {
            "AddQuoteLineRequest": {
                "type": "object",
                "properties": {
                    "part_id": {
                        "type": "integer"
                    },
                    "quantity": {
                        "type": "integer",
                        "minimum": 1
                    },
                    "colour": {
                        "type": [
                            "string",
                            "null"
                        ],
                        "maxLength": 100
                    }
                },
                "required": [
                    "part_id",
                    "quantity"
                ],
                "title": "AddQuoteLineRequest"
            },
            "BrandResource": {
                "type": "object",
                "properties": {
                    "name": {
                        "type": "string"
                    },
                    "count": {
                        "type": "integer"
                    }
                },
                "required": [
                    "name",
                    "count"
                ],
                "title": "BrandResource"
            },
            "Condition": {
                "type": "string",
                "enum": [
                    "new",
                    "used"
                ],
                "title": "Condition"
            },
            "PartResource": {
                "type": "object",
                "properties": {
                    "id": {
                        "type": "integer"
                    },
                    "name": {
                        "type": "string"
                    },
                    "oem": {
                        "type": "string"
                    },
                    "brand": {
                        "type": "string"
                    },
                    "category": {
                        "type": "string"
                    },
                    "condition": {
                        "type": "string",
                        "enum": [
                            "new",
                            "used"
                        ]
                    },
                    "price_cents": {
                        "type": "integer"
                    },
                    "stock_quantity": {
                        "type": "integer"
                    },
                    "in_stock": {
                        "type": "boolean"
                    },
                    "image": {
                        "type": "string"
                    },
                    "colours": {
                        "type": "array",
                        "items": {
                            "type": "string"
                        }
                    }
                },
                "required": [
                    "id",
                    "name",
                    "oem",
                    "brand",
                    "category",
                    "condition",
                    "price_cents",
                    "stock_quantity",
                    "in_stock",
                    "image",
                    "colours"
                ],
                "title": "PartResource"
            },
            "QuoteLineResource": {
                "type": "object",
                "properties": {
                    "id": {
                        "type": "integer"
                    },
                    "part_id": {
                        "type": "integer"
                    },
                    "name": {
                        "type": "string"
                    },
                    "oem": {
                        "type": "string"
                    },
                    "image": {
                        "type": "string"
                    },
                    "colour": {
                        "type": [
                            "string",
                            "null"
                        ]
                    },
                    "quantity": {
                        "type": "integer"
                    },
                    "backorder": {
                        "type": "boolean"
                    },
                    "unit_price_cents": {
                        "type": "integer"
                    },
                    "line_total_cents": {
                        "type": "integer"
                    }
                },
                "required": [
                    "id",
                    "part_id",
                    "name",
                    "oem",
                    "image",
                    "colour",
                    "quantity",
                    "backorder",
                    "unit_price_cents",
                    "line_total_cents"
                ],
                "title": "QuoteLineResource"
            },
            "QuoteResource": {
                "type": "object",
                "properties": {
                    "id": {
                        "type": "integer"
                    },
                    "status": {
                        "type": "string",
                        "enum": [
                            "draft",
                            "submitted"
                        ]
                    },
                    "submitted_at": {
                        "type": [
                            "string",
                            "null"
                        ]
                    },
                    "discount_percentage": {
                        "type": "number"
                    },
                    "vat_percentage": {
                        "type": "number"
                    },
                    "lines": {
                        "type": "array",
                        "items": {
                            "$ref": "#/components/schemas/QuoteLineResource"
                        }
                    },
                    "warnings": {
                        "type": "array",
                        "items": {
                            "type": "object",
                            "properties": {
                                "code": {
                                    "type": "string"
                                },
                                "message": {
                                    "type": "string"
                                },
                                "line_ids": {
                                    "type": "array",
                                    "items": {
                                        "type": "integer"
                                    }
                                }
                            },
                            "required": [
                                "code",
                                "message",
                                "line_ids"
                            ]
                        }
                    },
                    "totals": {
                        "type": "object",
                        "properties": {
                            "subtotal_cents": {
                                "type": "integer"
                            },
                            "discount_cents": {
                                "type": "integer"
                            },
                            "vat_cents": {
                                "type": "integer"
                            },
                            "total_cents": {
                                "type": "integer"
                            }
                        },
                        "required": [
                            "subtotal_cents",
                            "discount_cents",
                            "vat_cents",
                            "total_cents"
                        ]
                    }
                },
                "required": [
                    "id",
                    "status",
                    "submitted_at",
                    "discount_percentage",
                    "vat_percentage",
                    "lines",
                    "warnings",
                    "totals"
                ],
                "title": "QuoteResource"
            },
            "UpdateQuoteLineRequest": {
                "type": "object",
                "properties": {
                    "quantity": {
                        "type": "integer",
                        "minimum": 1
                    },
                    "colour": {
                        "type": [
                            "string",
                            "null"
                        ],
                        "maxLength": 100
                    }
                },
                "title": "UpdateQuoteLineRequest"
            },
            "WorkshopResource": {
                "type": "object",
                "properties": {
                    "id": {
                        "type": "integer"
                    },
                    "name": {
                        "type": "string"
                    },
                    "discount_percentage": {
                        "type": "number"
                    }
                },
                "required": [
                    "id",
                    "name",
                    "discount_percentage"
                ],
                "title": "WorkshopResource"
            }
        },
        "responses": {
            "AuthenticationException": {
                "description": "Unauthenticated",
                "content": {
                    "application/json": {
                        "schema": {
                            "type": "object",
                            "properties": {
                                "message": {
                                    "type": "string",
                                    "description": "Error overview."
                                }
                            },
                            "required": [
                                "message"
                            ]
                        }
                    }
                }
            },
            "ValidationException": {
                "description": "Validation error",
                "content": {
                    "application/json": {
                        "schema": {
                            "type": "object",
                            "properties": {
                                "message": {
                                    "type": "string",
                                    "description": "Errors overview."
                                },
                                "errors": {
                                    "type": "object",
                                    "description": "A detailed description of each field that failed validation.",
                                    "additionalProperties": {
                                        "type": "array",
                                        "items": {
                                            "type": "string"
                                        }
                                    }
                                }
                            },
                            "required": [
                                "message",
                                "errors"
                            ]
                        }
                    }
                }
            },
            "ModelNotFoundException": {
                "description": "Not found",
                "content": {
                    "application/json": {
                        "schema": {
                            "type": "object",
                            "properties": {
                                "message": {
                                    "type": "string",
                                    "description": "Error overview."
                                }
                            },
                            "required": [
                                "message"
                            ]
                        }
                    }
                }
            },
            "AuthorizationException": {
                "description": "Authorization error",
                "content": {
                    "application/json": {
                        "schema": {
                            "type": "object",
                            "properties": {
                                "message": {
                                    "type": "string",
                                    "description": "Error overview."
                                }
                            },
                            "required": [
                                "message"
                            ]
                        }
                    }
                }
            }
        }
    }
}